<?xml version='1.0' encoding='utf-8'?>
<robot name="KitchenPot">
  <!-- Mesh coordinates and prismatic limits use MonoArt's normalized object units. -->
  <link name="base" />
  <link name="link_0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/link_0.glb" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/link_0.glb" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_link_0" type="fixed">
    <parent link="base" />
    <child link="link_0" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/link_1.glb" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/link_1.glb" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_link_1" type="prismatic">
    <parent link="base" />
    <child link="link_1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="-0.00458357529 -0.999436734 0.0332446396" />
    <limit effort="1" velocity="1" lower="-0.0125999469" upper="0.00374553725" />
  </joint>
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/link_2.glb" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/link_2.glb" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_link_2" type="prismatic">
    <parent link="base" />
    <child link="link_2" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="-0.987695365 -0.152921582 0.0327544686" />
    <limit effort="1" velocity="1" lower="-0.0093850249" upper="0.00475092628" />
  </joint>
</robot>
